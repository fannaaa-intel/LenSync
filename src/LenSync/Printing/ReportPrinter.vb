Option Strict On
Option Explicit On
Option Infer On

Imports System.Drawing.Drawing2D
Imports System.Drawing.Printing
Imports System.Drawing.Text
Imports System.Globalization
Imports LenSync.Core
Imports LenSync.Models
Imports LenSync.UI
Imports LenSync.UI.Dialogs
Imports LenSync.Printing.PrintKit

Namespace Printing

    ''' <summary>
    ''' A report laid out on letter pages (8.5" x 11"): studio header, summary figures, tables that continue across pages
    ''' with their headers repeated, the owner's signature on the last page, and the proof footer on every page
    ''' (generated by, printer, date/time, report no., verification code, page x of y). Drawing is in points, so the
    ''' preview bitmaps and the printout are the same drawing. Dispose it to release the logo/signature images.
    ''' </summary>
    Public NotInheritable Class ReportPrinter
        Implements IDisposable

        Public Const PageWidthPt As Single = 612.0F
        Public Const PageHeightPt As Single = 792.0F
        Private Const Side As Single = 42.0F
        Private Const Top As Single = 36.0F
        Private Const FooterH As Single = 78.0F
        Private Const BottomGap As Single = 30.0F
        Private Const RowH As Single = 14.5F
        Private Const ContentBottom As Single = PageHeightPt - BottomGap - FooterH - 10
        Private Const ContentW As Single = PageWidthPt - Side * 2
        Private Shared ReadOnly PH As CultureInfo = CultureInfo.GetCultureInfo("en-PH")

        Private ReadOnly _data As ReportData
        Private ReadOnly _pages As New List(Of List(Of Action(Of Graphics)))
        Private ReadOnly _logo As Image
        Private ReadOnly _signature As Image
        Private _y As Single

        Public Sub New(data As ReportData)
            _data = data
            _logo = LoadImage(data.LogoPath)
            _signature = LoadImage(data.SignaturePath)
            Paginate()
        End Sub

        Public ReadOnly Property Data As ReportData
            Get
                Return _data
            End Get
        End Property

        Public ReadOnly Property PageCount As Integer
            Get
                Return _pages.Count
            End Get
        End Property

        ' ================================================================ layout
        Private ReadOnly Property Ops As List(Of Action(Of Graphics))
            Get
                Return _pages(_pages.Count - 1)
            End Get
        End Property

        Private Sub NewPage()
            _pages.Add(New List(Of Action(Of Graphics)))
            If _pages.Count = 1 Then
                Ops.Add(AddressOf DrawFirstHeader)
                _y = Top + 132
            Else
                Ops.Add(AddressOf DrawContinuationHeader)
                _y = Top + 30
            End If
        End Sub

        Private Sub Paginate()
            NewPage()
            For Each table In _data.Tables
                Dim t = table
                Dim titleH = If(t.Title.Length > 0, 18.0F, 0.0F)
                If _y + titleH + RowH * 3 > ContentBottom Then NewPage()
                AddTableHead(t, False)
                If t.Rows.Count = 0 Then
                    Dim y0 = _y
                    Ops.Add(Sub(g) Text(g, "No sales in this period.", Theme.Print.Body, Theme.Slate, New RectangleF(Side, y0, ContentW, RowH)))
                    _y += RowH
                End If
                For i = 0 To t.Rows.Count - 1
                    If _y + RowH > ContentBottom Then
                        NewPage()
                        AddTableHead(t, True)
                    End If
                    Dim cells = t.Rows(i)
                    Dim muted = t.Muted(i)
                    Dim y0 = _y
                    Ops.Add(Sub(g) DrawRow(g, t, cells, y0, If(muted, Theme.Silver, Theme.Ink), Theme.Print.Body))
                    _y += RowH
                Next
                If t.Totals IsNot Nothing Then
                    If _y + RowH + 4 > ContentBottom Then
                        NewPage()
                        AddTableHead(t, True)
                    End If
                    Dim y0 = _y + 2
                    Ops.Add(Sub(g)
                                Rule(g, Side, Side + ContentW, y0, Theme.Ink, 0.6F)
                                DrawRow(g, t, t.Totals, y0 + 2, Theme.Ink, Theme.Print.BodyBold)
                            End Sub)
                    _y += RowH + 4
                End If
                If t.Note.Length > 0 Then
                    If _y + 12 > ContentBottom Then NewPage()
                    Dim y0 = _y + 2
                    Ops.Add(Sub(g) Text(g, t.Note, Theme.Print.Small, Theme.Slate, New RectangleF(Side, y0, ContentW, 10)))
                    _y += 14
                End If
                _y += 14
            Next
            ' Owner's signature after the last table.
            If _y + 70 > ContentBottom Then NewPage()
            Dim sy = Math.Max(_y + 6, ContentBottom - 70)
            Ops.Add(Sub(g) DrawSignature(g, sy))
        End Sub

        Private Sub AddTableHead(t As ReportTable, continued As Boolean)
            If t.Title.Length > 0 OrElse continued Then
                Dim title = If(t.Title.Length > 0, t.Title, _data.Title) & If(continued, " (continued)", "")
                Dim y0 = _y
                Ops.Add(Sub(g) Text(g, title, Theme.Print.BodyBold, Theme.Ink, New RectangleF(Side, y0, ContentW, 14)))
                _y += 18
            End If
            Dim yh = _y
            Ops.Add(Sub(g)
                        DrawRow(g, t, t.Columns.Select(Function(c) c.Header.ToUpperInvariant()).ToArray(), yh, Theme.Slate, Theme.Print.SmallBold)
                        Rule(g, Side, Side + ContentW, yh + RowH - 2, Theme.Silver, 0.5F)
                    End Sub)
            _y += RowH + 2
        End Sub

        ' ================================================================ drawing
        ''' <summary>Draws page <paramref name="index"/> on a Graphics already in points with (0,0) at the paper's corner.</summary>
        Public Sub Render(g As Graphics, index As Integer)
            g.SmoothingMode = SmoothingMode.AntiAlias
            g.TextRenderingHint = TextRenderingHint.AntiAliasGridFit
            Using pen As New Pen(Theme.Silver, 0.8F)
                Gfx.DrawViewfinder(g, New RectangleF(14, 14, PageWidthPt - 28, PageHeightPt - 28), 20, pen)
            End Using
            For Each op In _pages(index)
                op(g)
            Next
            DrawFooter(g, index)
        End Sub

        Private Sub DrawRow(g As Graphics, t As ReportTable, cells As String(), y As Single, color As Color, font As Font)
            Dim totalWeight = t.Columns.Sum(Function(c) c.Weight)
            Dim x = Side
            For i = 0 To t.Columns.Count - 1
                Dim w = ContentW * t.Columns(i).Weight / totalWeight
                Dim cell = If(i < cells.Length, cells(i), "")
                Dim pad = 4.0F
                Text(g, cell, font, color, New RectangleF(x + pad, y, w - pad * 2, RowH),
                     If(t.Columns(i).AlignRight, StringAlignment.Far, StringAlignment.Near))
                x += w
            Next
        End Sub

        Private Sub DrawFirstHeader(g As Graphics)
            Dim textX = Side
            If _logo IsNot Nothing Then
                Dim size = DrawFitted(g, _logo, Side, Top, 90, 46)
                textX = Side + size.Width + 12
            End If
            Dim leftW = ContentW * 0.55F - (textX - Side)
            Text(g, _data.BusinessName, Theme.Print.Studio, Theme.Ink, New RectangleF(textX, Top, leftW, 18))
            If _data.Address.Length > 0 Then Text(g, _data.Address, Theme.Print.Small, Theme.Slate, New RectangleF(textX, Top + 19, leftW, 10))
            If _data.Contact.Length > 0 Then Text(g, _data.Contact, Theme.Print.Small, Theme.Slate, New RectangleF(textX, Top + 29, leftW, 10))

            Dim right = Side + ContentW
            Tracked(g, (_data.Title & " report").ToUpperInvariant(), Theme.Print.DocTitle, Theme.Ink, right, Top + 2, 1.4F, StringAlignment.Far)
            Text(g, ReportService.PeriodText(_data.DateFrom, _data.DateTo), Theme.Print.Body, Theme.Ink, New RectangleF(Side + ContentW * 0.4F, Top + 18, ContentW * 0.6F, 12), StringAlignment.Far)
            Text(g, ReportTypes.Description(_data.Type), Theme.Print.Small, Theme.Slate, New RectangleF(Side + ContentW * 0.3F, Top + 31, ContentW * 0.7F, 10), StringAlignment.Far)
            Rule(g, Side, right, Top + 54, Theme.Ink, 0.8F)

            ' Summary figures.
            Dim n = _data.Summary.Count
            If n = 0 Then Return
            Dim gap = 8.0F
            Dim boxW = (ContentW - gap * (n - 1)) / n
            Dim by = Top + 66
            For i = 0 To n - 1
                Dim bx = Side + i * (boxW + gap)
                Using p As New Pen(Theme.Mist, 0.8F)
                    Using path = Gfx.RoundedRect(New RectangleF(bx, by, boxW, 46), 4)
                        g.DrawPath(p, path)
                    End Using
                End Using
                Text(g, _data.Summary(i).Key.ToUpperInvariant(), Theme.Print.SmallBold, Theme.Slate, New RectangleF(bx + 8, by + 7, boxW - 16, 10))
                Text(g, _data.Summary(i).Value, Theme.Print.Total, Theme.Ink, New RectangleF(bx + 8, by + 20, boxW - 16, 18))
            Next
        End Sub

        Private Sub DrawContinuationHeader(g As Graphics)
            Text(g, $"{_data.BusinessName}  ·  {_data.Title}  ·  {ReportService.PeriodText(_data.DateFrom, _data.DateTo)}",
                 Theme.Print.Small, Theme.Slate, New RectangleF(Side, Top, ContentW, 10))
            Rule(g, Side, Side + ContentW, Top + 14, Theme.Silver, 0.5F)
        End Sub

        Private Sub DrawSignature(g As Graphics, y As Single)
            ' Left: who prepared it. Right: the owner's signature (from Settings > Studio) over a line.
            Dim colW = 190.0F
            Dim lineY = y + 50
            Rule(g, Side, Side + colW, lineY, Theme.Ink, 0.5F)
            Text(g, If(_data.GeneratedBy.Length > 0, _data.GeneratedBy, Session.CurrentUser?.FullName), Theme.Print.Body, Theme.Ink, New RectangleF(Side, lineY - 14, colW, 12))
            Text(g, "Prepared by", Theme.Print.Small, Theme.Slate, New RectangleF(Side, lineY + 2, colW, 10))
            Dim rx = Side + ContentW - colW
            If _signature IsNot Nothing Then DrawFitted(g, _signature, rx + 20, y, colW - 40, 46)
            Rule(g, rx, rx + colW, lineY, Theme.Ink, 0.5F)
            Text(g, "Owner's signature", Theme.Print.Small, Theme.Slate, New RectangleF(rx, lineY + 2, colW, 10), StringAlignment.Far)
        End Sub

        Private Sub DrawFooter(g As Graphics, index As Integer)
            Dim fy = PageHeightPt - BottomGap - FooterH
            Dim right = Side + ContentW
            Rule(g, Side, right, fy, Theme.Ink, 0.8F)
            Dim issued = _data.IsIssued
            Dim at = If(_data.GeneratedAt.HasValue, _data.GeneratedAt.Value.ToString("MMM d, yyyy h:mm:ss tt", PH), "Not printed yet")
            Dim rows = {
                Tuple.Create("Generated by", If(issued, _data.GeneratedBy, "—")),
                Tuple.Create("Printer", If(issued, _data.PrinterName, "—")),
                Tuple.Create("Date and time", at)}
            For i = 0 To rows.Length - 1
                Dim ry = fy + 8 + i * 13
                Text(g, rows(i).Item1, Theme.Print.Small, Theme.Slate, New RectangleF(Side, ry + 1, 60, 10))
                Text(g, rows(i).Item2, Theme.Print.Body, Theme.Ink, New RectangleF(Side + 62, ry, 180, 12))
            Next
            Dim mx = Side + 262
            Text(g, "REPORT NO.", Theme.Print.SmallBold, Theme.Slate, New RectangleF(mx, fy + 8, 120, 10))
            Text(g, If(issued, _data.ReportNo, "Given when printed"), Theme.Print.BodyBold, Theme.Ink, New RectangleF(mx, fy + 20, 120, 12))
            Text(g, "VERIFICATION CODE", Theme.Print.SmallBold, Theme.Slate, New RectangleF(right - 150, fy + 8, 150, 10), StringAlignment.Far)
            If issued Then
                Tracked(g, ReportService.FormatCode(_data.VerificationCode), Theme.Print.Total, Theme.Ink, right, fy + 19, 1.2F, StringAlignment.Far)
            Else
                Text(g, "Given when printed", Theme.Print.BodyBold, Theme.Ink, New RectangleF(right - 150, fy + 20, 150, 12), StringAlignment.Far)
            End If
            Dim by = PageHeightPt - BottomGap - 12
            Text(g, "Check this report in LENSYNC: Reports > Verify, using the report no. and verification code.",
                 Theme.Print.Small, Theme.Slate, New RectangleF(Side, by, ContentW - 80, 10))
            Text(g, $"Page {index + 1} of {_pages.Count}", Theme.Print.SmallBold, Theme.Ink, New RectangleF(right - 80, by, 80, 10), StringAlignment.Far)
        End Sub

        ' ================================================================ preview / print
        Public Function RenderPreview(index As Integer, widthPx As Integer) As Bitmap
            Dim bmp = NewPageBitmap(widthPx, PageWidthPt, PageHeightPt)
            Using g = Graphics.FromImage(bmp)
                g.Clear(Theme.White)
                g.PageUnit = GraphicsUnit.Point
                Render(g, Math.Max(0, Math.Min(PageCount - 1, index)))
            End Using
            Return bmp
        End Function

        ''' <summary>Shows the printer picker. Returns the chosen settings, or Nothing if cancelled / no printer.</summary>
        Public Shared Function ChoosePrinter(owner As IWin32Window) As PrinterSettings
            If PrinterSettings.InstalledPrinters.Count = 0 Then
                LsDialog.Warning("No printer is installed on this computer. Add one in Windows Settings > Printers & scanners, then try again.",
                                 "No printer found")
                Return Nothing
            End If
            Dim settings As New PrinterSettings()
            Using dlg As New PrintDialog() With {.PrinterSettings = settings, .UseEXDialog = True, .AllowSomePages = False,
                                                 .AllowSelection = False, .AllowPrintToFile = False}
                If dlg.ShowDialog(owner) <> DialogResult.OK Then Return Nothing
            End Using
            Return settings
        End Function

        ''' <summary>Prints every page on <paramref name="settings"/>' printer (call after the report was issued).</summary>
        Public Sub Print(settings As PrinterSettings)
            Using doc As New PrintDocument()
                doc.PrinterSettings = settings
                doc.DocumentName = If(_data.IsIssued, $"{_data.ReportNo} {_data.Title}", _data.Title)
                doc.DefaultPageSettings.PaperSize = Letter(settings)
                doc.DefaultPageSettings.Landscape = False
                doc.DefaultPageSettings.Margins = New Margins(0, 0, 0, 0)
                doc.PrintController = New StandardPrintController()
                Dim page = 0
                AddHandler doc.PrintPage,
                    Sub(sender, e)
                        PreparePrinterGraphics(e)
                        Render(e.Graphics, page)
                        page += 1
                        e.HasMorePages = page < PageCount
                    End Sub
                doc.Print()
            End Using
        End Sub

        Private Shared Function Letter(settings As PrinterSettings) As PaperSize
            For Each size As PaperSize In settings.PaperSizes
                If size.Kind = PaperKind.Letter Then Return size
            Next
            Return New PaperSize("Letter", 850, 1100)
        End Function

        Public Sub Dispose() Implements IDisposable.Dispose
            _logo?.Dispose()
            _signature?.Dispose()
        End Sub

    End Class

End Namespace
