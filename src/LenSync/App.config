<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The connection string lives ONLY here so the app can move to another PC/server without a rebuild. -->
  <connectionStrings>
    <add name="LenSyncDb"
         connectionString="Server=localhost;Port=3306;Database=lensync_db;Uid=root;Pwd=;CharSet=utf8mb4;SslMode=Disabled;AllowPublicKeyRetrieval=True;Connection Timeout=5;Default Command Timeout=30"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
